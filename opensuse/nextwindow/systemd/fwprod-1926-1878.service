[Unit]
ConditionPathExists=/etc/systemd/system/multi-user.target.wants/bypssd-nextwindow.service
Description=Exec fwprod (Next Window Touchscreen)

[Service]
Environment=LD_LIBRARY_PATH=/usr/libexec/bypssd-nextwindow
Type=forking
ExecStart=/usr/libexec/bypssd-nextwindow/fwprod /product_id 0x1878 /message 004302F001 /padding_size 65 /timeout 300 /daemon

