#!/bin/bash
set -euo pipefail
id liveuser >/dev/null
hostnamectl set-hostname bypssd-live
usermod -c 'Sesión en vivo de BYPSSD OS' liveuser
mkdir -p /home/liveuser/.config /home/liveuser/Desktop /home/liveuser/.local/share/applications
cat > /home/liveuser/.config/kickoffrc <<'EOF'
[Favorites]
FavoriteURLs=/usr/share/applications/chromium-browser.desktop,/usr/share/applications/org.kde.dolphin.desktop,/usr/share/applications/libreoffice-writer.desktop,/usr/share/applications/org.kde.okular.desktop,/usr/share/applications/systemsettings.desktop
EOF
install -m 755 /usr/share/bypssd/bypssd-instalar.desktop /home/liveuser/Desktop/liveinst.desktop
install -m 755 /usr/share/bypssd/bypssd-instalar.desktop /home/liveuser/.local/share/applications/liveinst.desktop
chown -R liveuser:liveuser /home/liveuser
restorecon -RF /home/liveuser
